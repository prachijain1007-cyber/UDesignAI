// UDesign AI — Prisma schema
// Postgres schema backing the marketing site, AI design studio,
// WhatsApp assistant, lead CRM and admin analytics dashboard.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Admin / Auth
// ---------------------------------------------------------------------------

enum AdminRole {
  OWNER
  ADMIN
  DESIGNER
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         AdminRole @default(DESIGNER)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastLoginAt  DateTime?

  assignedLeads Lead[]     @relation("AssignedLeads")
  notes         LeadNote[]

  @@map("admin_users")
}

// ---------------------------------------------------------------------------
// Visitor sessions & website activity tracking
// ---------------------------------------------------------------------------

model VisitorSession {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  deviceType   String? // mobile | tablet | desktop
  browser      String?
  os           String?
  userAgent    String?
  referrer     String?
  utmSource    String?
  utmMedium    String?
  utmCampaign  String?
  landingPath  String?
  timeOnSiteMs Int      @default(0)
  pageViews    Int      @default(0)
  whatsappClicked Boolean @default(false)
  firstSeenAt  DateTime @default(now())
  lastSeenAt   DateTime @updatedAt

  lead     Lead?
  events        WebsiteEvent[]
  designs       GeneratedDesign[]
  images        ImageAsset[]
  conversations Conversation[]
  consultations Consultation[]

  @@index([lastSeenAt])
  @@map("visitor_sessions")
}

enum WebsiteEventType {
  PAGE_VIEW
  STYLE_SELECTED
  ROOM_SELECTED
  DESIGN_GENERATED
  IMAGE_UPLOADED
  PRICING_VIEWED
  CONSULTATION_VIEWED
  WHATSAPP_CLICKED
  CTA_CLICKED
  CHAT_OPENED
  CHAT_MESSAGE_SENT
}

model WebsiteEvent {
  id        String           @id @default(cuid())
  sessionId String
  session   VisitorSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  type      WebsiteEventType
  path      String?
  metadata  Json?
  createdAt DateTime         @default(now())

  @@index([sessionId, createdAt])
  @@index([type, createdAt])
  @@map("website_events")
}

// ---------------------------------------------------------------------------
// Room images & AI-generated designs
// ---------------------------------------------------------------------------

model ImageAsset {
  id           String   @id @default(cuid())
  sessionId    String
  session      VisitorSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  url          String
  storageKey   String
  mimeType     String
  sizeBytes    Int
  roomTypeGuess String?
  createdAt    DateTime @default(now())

  designs GeneratedDesign[]

  @@index([sessionId])
  @@map("image_assets")
}

enum DesignStatus {
  PENDING
  COMPLETED
  FAILED
}

model GeneratedDesign {
  id             String         @id @default(cuid())
  sessionId      String
  session        VisitorSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  roomType       String
  style          String
  sourceImageId  String?
  sourceImage    ImageAsset?    @relation(fields: [sourceImageId], references: [id])
  prompt         String
  resultImageUrl String?
  status         DesignStatus   @default(PENDING)
  createdAt      DateTime       @default(now())

  @@index([sessionId, createdAt])
  @@map("generated_designs")
}

// ---------------------------------------------------------------------------
// Leads / CRM
// ---------------------------------------------------------------------------

enum LeadSource {
  WEBSITE
  WHATSAPP
  MANUAL
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONSULTATION_BOOKED
  WON
  LOST
}

enum LeadTier {
  HOT
  WARM
  COLD
}

enum Ownership {
  OWNER
  RENTER
  UNSURE
}

model Lead {
  id               String     @id @default(cuid())
  sessionId        String?    @unique
  session          VisitorSession? @relation(fields: [sessionId], references: [id])
  name             String?
  email            String?
  phone            String?
  whatsappNumber   String?    @unique
  source           LeadSource @default(WEBSITE)
  status           LeadStatus @default(NEW)
  score            Int        @default(0)
  tier             LeadTier   @default(COLD)
  budget           String?
  timeline         String?
  projectSize      String?
  ownership        Ownership?
  urgency          String?
  decisionReadiness String?
  roomType         String?
  style            String?
  tags             String[]   @default([])
  assignedToId     String?
  assignedTo       AdminUser? @relation("AssignedLeads", fields: [assignedToId], references: [id])
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  notes         LeadNote[]
  scoreHistory  LeadScoreHistory[]
  conversations Conversation[]
  consultations Consultation[]

  @@index([tier, status])
  @@index([createdAt])
  @@map("leads")
}

model LeadNote {
  id          String    @id @default(cuid())
  leadId      String
  lead        Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  adminUserId String?
  adminUser   AdminUser? @relation(fields: [adminUserId], references: [id])
  body        String
  createdAt   DateTime  @default(now())

  @@map("lead_notes")
}

model LeadScoreHistory {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  score     Int
  tier      LeadTier
  reason    String
  createdAt DateTime @default(now())

  @@map("lead_score_history")
}

// ---------------------------------------------------------------------------
// Conversations (website chat + WhatsApp) & messages
// ---------------------------------------------------------------------------

enum ConversationChannel {
  WEBSITE_CHAT
  WHATSAPP
}

enum ConversationStatus {
  ACTIVE
  CLOSED
}

model Conversation {
  id             String              @id @default(cuid())
  leadId         String?
  lead           Lead?               @relation(fields: [leadId], references: [id])
  sessionId      String?
  session        VisitorSession?     @relation(fields: [sessionId], references: [id])
  channel        ConversationChannel
  whatsappPhone  String?
  status         ConversationStatus  @default(ACTIVE)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  messages Message[]

  @@index([whatsappPhone])
  @@index([leadId])
  @@map("conversations")
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum MessageDeliveryStatus {
  SENT
  DELIVERED
  READ
  FAILED
}

model Message {
  id                 String                 @id @default(cuid())
  conversationId     String
  conversation       Conversation           @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role               MessageRole
  content            String
  whatsappMessageId  String?                @unique
  deliveryStatus     MessageDeliveryStatus?
  createdAt          DateTime               @default(now())

  @@index([conversationId, createdAt])
  @@map("messages")
}

// ---------------------------------------------------------------------------
// Consultations
// ---------------------------------------------------------------------------

enum ConsultationStatus {
  REQUESTED
  CONFIRMED
  COMPLETED
  CANCELLED
}

model Consultation {
  id             String             @id @default(cuid())
  leadId         String?
  lead           Lead?              @relation(fields: [leadId], references: [id])
  sessionId      String?
  session        VisitorSession?    @relation(fields: [sessionId], references: [id])
  preferredDate  String
  preferredTime  String
  email          String
  phone          String
  notes          String?
  status         ConsultationStatus @default(REQUESTED)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([status, preferredDate])
  @@map("consultations")
}
