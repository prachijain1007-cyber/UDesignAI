# ---------------------------------------------------------------------------
# UDesign AI — environment variables
# Copy this file to .env for local development: cp .env.example .env
# ---------------------------------------------------------------------------

# Postgres connection string (Railway / Render / Supabase / local Docker all work)
DATABASE_URL="postgresql://udesignai:udesignai@localhost:5432/udesignai?schema=public"

# Public site URL (used for metadata, OG tags, absolute links)
NEXT_PUBLIC_SITE_URL="https://udesignai.com"

# --- OpenAI -----------------------------------------------------------------
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-5"
# Optional: model used for image/room understanding if different from OPENAI_MODEL
OPENAI_VISION_MODEL="gpt-5"

# --- Meta WhatsApp Cloud API --------------------------------------------------
WHATSAPP_CLOUD_API_TOKEN="EAAG..."
WHATSAPP_PHONE_NUMBER_ID="000000000000000"
WHATSAPP_BUSINESS_ACCOUNT_ID="000000000000000"
# Arbitrary string you choose; must match the value entered in the Meta webhook config
WHATSAPP_WEBHOOK_VERIFY_TOKEN="change-me-webhook-verify-token"
# App secret from Meta App dashboard, used to verify X-Hub-Signature-256
WHATSAPP_APP_SECRET="change-me-app-secret"

# Public WhatsApp number shown on the floating button, digits only, with country code
NEXT_PUBLIC_WHATSAPP_NUMBER="15550123456"

# --- Admin auth ---------------------------------------------------------------
# Long random string used to sign admin session JWTs — generate with `openssl rand -hex 32`
ADMIN_JWT_SECRET="change-me-to-a-long-random-string"

# --- File storage ---------------------------------------------------------------
# "local" stores uploads under /public/uploads (fine for demos / single-instance deploys).
# Set to "s3" and fill the S3_* vars for production multi-instance deployments.
STORAGE_DRIVER="local"
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""
